[user]
name = {{ .name }}
email = {{ .personalEmail }}
signingkey = {{ .personalSigningKey }}
[includeIf "gitdir:Projects/Work/**"]
path = .gitconfig-work
[color]
diff = auto
status = auto
branch = auto
sh = auto
ui = true
[alias]
a = add -A
c = commit -m
ca = commit --amend --no-edit
st = status --untracked-files=all
ci = commit -v
ic = commit -v
br = branch -vv
bro = browse
co = checkout
df = diff
cp = cherry-pick
dc = diff --cached
ap = add --patch
unstage = reset HEAD
rollback = reset --soft HEAD^1
rc = rebase --continue
rs = rebase --skip
ra = rebase --abort
pp = push
ph = push -u origin HEAD
pf = push --force-with-lease origin HEAD
pt = push --tags
b = for-each-ref --sort=committerdate refs/heads/ --format='%(color:reset)%(refname:short) %(color:green)%(committerdate:relative)%(color:reset)'
cf = !branch="$(git branch --no-color 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \\(.*\\)/\\1/') && git checkout ${branch%--*}"
rh = reset --hard
mainbranch = "!git remote show origin | sed -n '/HEAD branch/s/.*: //p'"
sync = "!git fetch origin -v; git fetch upstream; git rebase upstream/$(git mainbranch); git push"
ammend = commit --amend
amend = commit --amend
pr = "!f() { open \"$(git ls-remote --get-url $(git config --get branch.$(git rev-parse --abbrev-ref HEAD).remote) | sed 's|git@[^:]*:|https://github.com/|' | sed 's|\\.git$||')/compare/$(git config --get branch.$(git rev-parse --abbrev-ref HEAD).merge | cut -d '/' -f 3-)?expand=1\"; }; f"
hub = "!f() { open \"$(git ls-remote --get-url | sed 's|git@[^:]*:|https://github.com/|' | sed 's|\\.git$||')\"; }; f"
restore = "!f() { git checkout $(git rev-list -n 1 HEAD -- $1)~1 -- $(git diff --name-status $(git rev-list -n 1 HEAD -- $1)~1 | grep '^D' | cut -f 2); }; f"
diff-all = !"for name in $(git diff --name-only $1); do git difftool -y $1 $name & done"
diff-changes = diff --name-status -r
diff-stat = diff --stat --ignore-space-change -r
diff-staged = diff --cached
diff-upstream = !git fetch origin && git diff master origin/master

[branch]
autosetupmerge = true
[core]
autocrlf = input
pager = delta
excludesfile = {{ .chezmoi.homeDir }}/.config/git/ignore
[merge]
verbosity = 5
tool = diffmerge
[diff]
verbosity = 5
tool = changes
algorithm = histogram
compactionHeuristic = true
[push]
default = current
[log]
date = local
[pull]
rebase = true
[commit]
gpgsign = true
[help]
  autocorrect = prompt 
[init]
  defaultBranch = main
[interactive]
diffFilter = delta --color-only
[delta]
navigate = true
line-numbers = true
side-by-side = false
syntax-theme = Monokai Extended
{{- if eq .sshAgent "1password" }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- else if eq .sshAgent "bitwarden" }}
[gpg]
	format = ssh
{{- end }}
