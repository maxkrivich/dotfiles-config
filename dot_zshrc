export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="af-magic"

plugins=(colored-man-pages git ruby nmap pip sudo tmux vscode python man gitignore dotenv ansible npm minikube microk8s kubectl httpie golang)

source $ZSH/oh-my-zsh.sh

source <(fzf --zsh)
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh



HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

# Options
setopt APPEND_HISTORY       # Don't overwrite history
setopt SHARE_HISTORY        # Share history between all sessions
setopt HIST_IGNORE_ALL_DUPS # Keep it clean
setopt HIST_REDUCE_BLANKS   # Remove wasted space


# Aliases
alias ls="eza --icons --group-directories-first"
alias ll="eza -lh --icons --git"
alias cat="bat"
alias grep="rg"
alias find="fd"
alias docker="podman"


eval "$(starship init zsh)"
eval "$(mise activate zsh)"
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
